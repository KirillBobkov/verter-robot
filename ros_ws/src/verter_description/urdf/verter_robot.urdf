<?xml version='1.0' encoding='utf-8' ?>
<robot name="verter_robot">
  <!--Lidar/IMU mounting confirmed unchanged by owner. Ultrasonic XYZ fitted to CAD at 148 mm, not surveyed.-->
  <material name="blue">
    <color rgba="0.0 0.0 0.8 1.0" />
