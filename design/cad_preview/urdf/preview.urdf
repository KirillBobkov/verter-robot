<?xml version="1.0" ?>
<robot name="verter_cad_preview">
  <!-- Visual review only. Body edge clearance 0.050 m and wheel width 0.050 m confirmed by owner on 2026-09-15. -->
  <link name="base_footprint" />
  <link name="base_link" />
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint" />
    <child link="base_link" />
    <origin xyz="0 0 0.098" />
  </joint>
  <link name="platform">
    <visual>
      <geometry>
        <mesh filename="package://verter_cad_preview/meshes/platform_aligned_m.stl" />
      </geometry>
      <material name="shell">
        <color rgba="0.55 0.65 0.75 1" />
      </material>
    </visual>
  </link>
  <joint name="platform_joint" type="fixed">
