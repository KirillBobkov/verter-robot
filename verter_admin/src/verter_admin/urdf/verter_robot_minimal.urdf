<?xml version="1.0"?>
<!-- URDF Model for Verter Robot - Minimal version for testing -->
<robot name="verter_robot">

  <!-- Materials -->
  <material name="blue">
    <color rgba="0.0 0.0 0.8 1.0"/>
  </material>

  <material name="black">
    <color rgba="0.0 0.0 0.0 1.0"/>
  </material>

  <material name="red">
    <color rgba="0.8 0.0 0.0 1.0"/>
  </material>

  <material name="gray">
    <color rgba="0.5 0.5 0.5 1.0"/>
  </material>

  <!-- Base Link (Main Body) -->
  <!-- Updated dimensions from CAD drawings: 560mm x 534mm x 550mm -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.275" rpy="0 0 0"/>
      <geometry>
        <box size="0.560 0.534 0.550"/>
      </geometry>
      <material name="blue"/>
    </visual>

    <collision>
      <origin xyz="0 0 0.275" rpy="0 0 0"/>
      <geometry>
        <box size="0.580 0.554 0.550"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0.275" rpy="0 0 0"/>
      <mass value="2.0"/>
      <inertia
        ixx="0.01" ixy="0.0" ixz="0.0"
        iyy="0.01" iyz="0.0"
        izz="0.01"/>
    </inertial>
  </link>

  <!-- Left Wheel -->
  <link name="wheel_left">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.1" length="0.05"/>
      </geometry>
      <material name="black"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.1" length="0.05"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia
        ixx="0.001" ixy="0.0" ixz="0.0"
        iyy="0.001" iyz="0.0"
        izz="0.001"/>
    </inertial>
  </link>

  <joint name="wheel_left_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_left"/>
    <origin xyz="0.120 0.178 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- Right Wheel -->
  <link name="wheel_right">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.1" length="0.05"/>
      </geometry>
      <material name="black"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.1" length="0.05"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia
        ixx="0.001" ixy="0.0" ixz="0.0"
        iyy="0.001" iyz="0.0"
        izz="0.001"/>
    </inertial>
  </link>

  <joint name="wheel_right_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_right"/>
    <origin xyz="0.120 -0.178 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- Caster Wheel (Back) -->
  <link name="caster_back">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.03"/>
      </geometry>
      <material name="gray"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.03"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.1"/>
      <inertia
        ixx="0.0001" ixy="0.0" ixz="0.0"
        iyy="0.0001" iyz="0.0"
        izz="0.0001"/>
    </inertial>
  </link>

  <joint name="caster_back_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_back"/>
    <origin xyz="-0.22 0 -0.07" rpy="0 0 0"/>
  </joint>

  <!-- Distance Sensors (7 sensors) -->
  <!-- Updated positions based on CAD drawings -->
  <!-- Sensors at height 148mm from ground = 0.048m from base_link -->

  <!-- 1. Front Center (0°) -->
  <link name="sensor_front_center">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.02 0.02"/>
      </geometry>
      <material name="red"/>
    </visual>
  </link>

  <joint name="sensor_front_center_joint" type="fixed">
    <parent link="base_link"/>
    <child link="sensor_front_center"/>
    <origin xyz="0.280 0 0.048" rpy="0 0 0"/>
  </joint>

  <!-- 2. Front Left Inner (5,7°) -->
  <link name="sensor_front_left_inner">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.02 0.02"/>
      </geometry>
      <material name="red"/>
    </visual>
  </link>

  <joint name="sensor_front_left_inner_joint" type="fixed">
    <parent link="base_link"/>
    <child link="sensor_front_left_inner"/>
    <origin xyz="0.277 0.074 0.048" rpy="0 0 0.0995"/>
  </joint>

  <!-- 3. Front Left Outer (13,2°) -->
  <link name="sensor_front_left_outer">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.02 0.02"/>
      </geometry>
      <material name="red"/>
    </visual>
  </link>

  <joint name="sensor_front_left_outer_joint" type="fixed">
    <parent link="base_link"/>
    <child link="sensor_front_left_outer"/>
    <origin xyz="0.262 0.152 0.048" rpy="0 0 0.2304"/>
  </joint>

  <!-- 4. Front Right Inner (-5,7°) -->
  <link name="sensor_front_right_inner">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.02 0.02"/>
      </geometry>
      <material name="red"/>
    </visual>
  </link>

  <joint name="sensor_front_right_inner_joint" type="fixed">
    <parent link="base_link"/>
    <child link="sensor_front_right_inner"/>
    <origin xyz="0.277 -0.074 0.048" rpy="0 0 -0.0995"/>
  </joint>

  <!-- 5. Front Right Outer (-13,2°) -->
  <link name="sensor_front_right_outer">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.02 0.02"/>
      </geometry>
      <material name="red"/>
    </visual>
  </link>

  <joint name="sensor_front_right_outer_joint" type="fixed">
    <parent link="base_link"/>
    <child link="sensor_front_right_outer"/>
    <origin xyz="0.262 -0.152 0.048" rpy="0 0 -0.2304"/>
  </joint>

  <!-- 6. Left Sensor (76) -->
  <link name="sensor_left">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.02 0.02"/>
      </geometry>
      <material name="red"/>
    </visual>
  </link>

  <joint name="sensor_left_joint" type="fixed">
    <parent link="base_link"/>
    <child link="sensor_left"/>
    <origin xyz="0.180 0.228 0.048" rpy="0 0 1.3265"/>
  </joint>

  <!-- 7. Right Sensor (-76 °) -->
  <link name="sensor_right">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.02 0.02"/>
      </geometry>
      <material name="red"/>
    </visual>
  </link>

  <joint name="sensor_right_joint" type="fixed">
    <parent link="base_link"/>
    <child link="sensor_right"/>
    <origin xyz="0.180 -0.228 0.048" rpy="0 0 -1.3265"/>
  </joint>
  <!-- ToF Camera (Arducam US981) -->
  <!-- Positioned at front-center, slightly above base_link -->
  <link name="camera_tof">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.03 0.06 0.02"/>
      </geometry>
      <material name="gray"/>
    </visual>
  </link>

  <joint name="camera_tof_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_tof"/>
    <!-- Position: front-center, height ~15cm from ground -->
    <origin xyz="0.150 0 0.400" rpy="0 0 0"/>
  </joint>

  <!-- ToF Camera Optical Frame (for point cloud data) -->
  <link name="camera_tof_optical"/>

  <joint name="camera_tof_optical_joint" type="fixed">
    <parent link="camera_tof"/>
    <child link="camera_tof_optical"/>
    <!-- Optical frame: Z forward, X right, Y down (standard camera convention) -->
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
  </joint>

  <!-- RPLiDAR A1M8 -->
  <!-- Positioned at top-center of robot -->
  <link name="lidar_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.035" length="0.04"/>
      </geometry>
      <material name="black"/>
    </visual>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <!-- Position: top-center of robot, height ~55cm from ground -->
    <origin xyz="0.0 0 0.450" rpy="0 0 0"/>
  </joint>

  <!-- Base Footprint -->
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
  </joint>

</robot>
