<?xml version="1.0"?>
<!-- URDF Model for Verter Robot - Minimal version for testing -->
<robot name="verter_robot">

  <!-- Materials -->
  <material name="blue">
    <color rgba="0.0 0.0 0.8 1.0"/>
  </material>

  <material name="black">
    <color rgba="0.0 0.0 0.0 1.0"/>
  </material>

  <material name="red">
    <color rgba="0.8 0.0 0.0 1.0"/>
  </material>

  <material name="gray">
    <color rgba="0.5 0.5 0.5 1.0"/>
  </material>

  <!-- Base Link (Main Body) -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry>
        <box size="0.40 0.50 1.50"/>
      </geometry>
      <material name="blue"/>
    </visual>

    <collision>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry>
        <box size="0.42 0.52 1.50"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <mass value="2.0"/>
      <inertia
        ixx="0.01" ixy="0.0" ixz="0.0"
        iyy="0.01" iyz="0.0"
        izz="0.01"/>
    </inertial>
  </link>

  <!-- Left Wheel -->
  <link name="wheel_left">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.1" length="0.05"/>
      </geometry>
      <material name="black"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.1" length="0.05"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia
        ixx="0.001" ixy="0.0" ixz="0.0"
        iyy="0.001" iyz="0.0"
        izz="0.001"/>
    </inertial>
  </link>

  <joint name="wheel_left_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_left"/>
    <origin xyz="0.10 0.11 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- Right Wheel -->
  <link name="wheel_right">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.1" length="0.05"/>
      </geometry>
      <material name="black"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.1" length="0.05"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia
        ixx="0.001" ixy="0.0" ixz="0.0"
        iyy="0.001" iyz="0.0"
        izz="0.001"/>
    </inertial>
  </link>

  <joint name="wheel_right_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_right"/>
    <origin xyz="0.10 -0.11 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- Caster Wheel (Back) -->
  <link name="caster_back">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.03"/>
      </geometry>
      <material name="gray"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.03"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.1"/>
      <inertial
        ixx="0.0001" ixy="0.0" ixz="0.0"
        iyy="0.0001" iyz="0.0"
        izz="0.0001"/>
    </inertial>
  </link>

  <joint name="caster_back_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_back"/>
    <origin xyz="-0.12 0 -0.07" rpy="0 0 0"/>
  </joint>

  <!-- Distance Sensors (7 sensors) -->

  <!-- 1. Front Center -->
  <link name="sensor_front_center">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.02 0.02"/>
      </geometry>
      <material name="red"/>
    </visual>
  </link>

  <joint name="sensor_front_center_joint" type="fixed">
    <parent link="base_link"/>
    <child link="sensor_front_center"/>
    <origin xyz="0.16 0 0.08" rpy="0 0 0"/>
  </joint>

  <!-- 2. Front Left Inner -->
  <link name="sensor_front_left_inner">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.02 0.02"/>
      </geometry>
      <material name="red"/>
    </visual>
  </link>

  <joint name="sensor_front_left_inner_joint" type="fixed">
    <parent link="base_link"/>
    <child link="sensor_front_left_inner"/>
    <origin xyz="0.15 0.05 0.08" rpy="0 0 0.4363"/>
  </joint>

  <!-- 3. Front Left Outer -->
  <link name="sensor_front_left_outer">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.02 0.02"/>
      </geometry>
      <material name="red"/>
    </visual>
  </link>

  <joint name="sensor_front_left_outer_joint" type="fixed">
    <parent link="base_link"/>
    <child link="sensor_front_left_outer"/>
    <origin xyz="0.14 0.10 0.08" rpy="0 0 0.7854"/>
  </joint>

  <!-- 4. Front Right Inner -->
  <link name="sensor_front_right_inner">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.02 0.02"/>
      </geometry>
      <material name="red"/>
    </visual>
  </link>

  <joint name="sensor_front_right_inner_joint" type="fixed">
    <parent link="base_link"/>
    <child link="sensor_front_right_inner"/>
    <origin xyz="0.15 -0.05 0.08" rpy="0 0 -0.4363"/>
  </joint>

  <!-- 5. Front Right Outer -->
  <link name="sensor_front_right_outer">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.02 0.02"/>
      </geometry>
      <material name="red"/>
    </visual>
  </link>

  <joint name="sensor_front_right_outer_joint" type="fixed">
    <parent link="base_link"/>
    <child link="sensor_front_right_outer"/>
    <origin xyz="0.14 -0.10 0.08" rpy="0 0 -0.7854"/>
  </joint>

  <!-- 6. Left Sensor -->
  <link name="sensor_left">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.02 0.02"/>
      </geometry>
      <material name="red"/>
    </visual>
  </link>

  <joint name="sensor_left_joint" type="fixed">
    <parent link="base_link"/>
    <child link="sensor_left"/>
    <origin xyz="0 0.11 0.08" rpy="0 0 1.5708"/>
  </joint>

  <!-- 7. Right Sensor -->
  <link name="sensor_right">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.02 0.02"/>
      </geometry>
      <material name="red"/>
    </visual>
  </link>

  <joint name="sensor_right_joint" type="fixed">
    <parent link="base_link"/>
    <child link="sensor_right"/>
    <origin xyz="0 -0.11 0.08" rpy="0 0 -1.5708"/>
  </joint>

  <!-- Base Footprint -->
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
  </joint>

</robot>
