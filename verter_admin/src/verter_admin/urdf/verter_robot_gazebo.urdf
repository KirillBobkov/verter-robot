<?xml version="1.0"?>
<!-- URDF Model for Verter Robot - Gazebo Simulation Version -->
<robot name="verter_robot">

  <!-- Materials -->
  <material name="blue">
    <color rgba="0.0 0.0 0.8 1.0"/>
  </material>

  <material name="black">
    <color rgba="0.0 0.0 0.0 1.0"/>
  </material>

  <material name="red">
    <color rgba="0.8 0.0 0.0 1.0"/>
  </material>

  <material name="gray">
    <color rgba="0.5 0.5 0.5 1.0"/>
  </material>

  <!-- Base Link (Main Body) -->
  <!-- Циліндрична форма для більш реалістичної моделі -->
  <!-- Радіус ~0.267м (половина ширини 534мм), висота 550мм -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.275" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.267" length="0.550"/>
      </geometry>
      <material name="blue"/>
    </visual>

    <collision>
      <origin xyz="0 0 0.275" rpy="0 0 0"/>
      <geometry>
        <!-- Collision трохи менший для кращої маневреності -->
        <cylinder radius="0.250" length="0.550"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0.120 0 -0.05" rpy="0 0 0"/>
      <mass value="12.0"/>
      <inertia
        ixx="0.25" ixy="0.0" ixz="0.0"
        iyy="0.25" iyz="0.0"
        izz="0.35"/>
    </inertial>
  </link>

  <!-- Left Wheel -->
  <link name="wheel_left">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.1" length="0.05"/>
      </geometry>
      <material name="black"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.1" length="0.05"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.8"/>
      <inertia
        ixx="0.005" ixy="0.0" ixz="0.0"
        iyy="0.005" iyz="0.0"
        izz="0.005"/>
    </inertial>
  </link>

  <joint name="wheel_left_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_left"/>
    <origin xyz="0.120 0.178 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.1" friction="0.05"/>
  </joint>

  <!-- Right Wheel -->
  <link name="wheel_right">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.1" length="0.05"/>
      </geometry>
      <material name="black"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.1" length="0.05"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.8"/>
      <inertia
        ixx="0.005" ixy="0.0" ixz="0.0"
        iyy="0.005" iyz="0.0"
        izz="0.005"/>
    </inertial>
  </link>

  <joint name="wheel_right_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_right"/>
    <origin xyz="0.120 -0.178 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.1" friction="0.05"/>
  </joint>

  <!-- Caster Wheel (Back) -->
  <link name="caster_back">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.05"/>
      </geometry>
      <material name="gray"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.05"/>
      </geometry>
      <surface>
        <friction>
          <ode>
            <mu>0.01</mu>
            <mu2>0.01</mu2>
          </ode>
        </friction>
      </surface>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia
        ixx="0.001" ixy="0.0" ixz="0.0"
        iyy="0.001" iyz="0.0"
        izz="0.001"/>
    </inertial>
  </link>

  <joint name="caster_back_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_back"/>
    <origin xyz="-0.22 0 -0.05" rpy="0 0 0"/>
  </joint>

  <!-- Distance Sensors (7 sensors) -->

  <!-- 1. Front Center (0°) -->
  <link name="sensor_front_center">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.02 0.02"/>
      </geometry>
      <material name="red"/>
    </visual>
  </link>

  <joint name="sensor_front_center_joint" type="fixed">
    <parent link="base_link"/>
    <child link="sensor_front_center"/>
    <origin xyz="0.280 0 0.048" rpy="0 0 0"/>
  </joint>

  <!-- 2. Front Left Inner (5,7°) -->
  <link name="sensor_front_left_inner">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.02 0.02"/>
      </geometry>
      <material name="red"/>
    </visual>
  </link>

  <joint name="sensor_front_left_inner_joint" type="fixed">
    <parent link="base_link"/>
    <child link="sensor_front_left_inner"/>
    <origin xyz="0.277 0.074 0.048" rpy="0 0 0.0995"/>
  </joint>

  <!-- 3. Front Left Outer (13,2°) -->
  <link name="sensor_front_left_outer">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.02 0.02"/>
      </geometry>
      <material name="red"/>
    </visual>
  </link>

  <joint name="sensor_front_left_outer_joint" type="fixed">
    <parent link="base_link"/>
    <child link="sensor_front_left_outer"/>
    <origin xyz="0.262 0.152 0.048" rpy="0 0 0.2304"/>
  </joint>

  <!-- 4. Front Right Inner (-5,7°) -->
  <link name="sensor_front_right_inner">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.02 0.02"/>
      </geometry>
      <material name="red"/>
    </visual>
  </link>

  <joint name="sensor_front_right_inner_joint" type="fixed">
    <parent link="base_link"/>
    <child link="sensor_front_right_inner"/>
    <origin xyz="0.277 -0.074 0.048" rpy="0 0 -0.0995"/>
  </joint>

  <!-- 5. Front Right Outer (-13,2°) -->
  <link name="sensor_front_right_outer">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.02 0.02"/>
      </geometry>
      <material name="red"/>
    </visual>
  </link>

  <joint name="sensor_front_right_outer_joint" type="fixed">
    <parent link="base_link"/>
    <child link="sensor_front_right_outer"/>
    <origin xyz="0.262 -0.152 0.048" rpy="0 0 -0.2304"/>
  </joint>

  <!-- 6. Left Sensor (76°) -->
  <!-- Винесений за межі корпусу для уникнення блокування променів -->
  <link name="sensor_left">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.02 0.02"/>
      </geometry>
      <material name="red"/>
    </visual>
  </link>

  <joint name="sensor_left_joint" type="fixed">
    <parent link="base_link"/>
    <child link="sensor_left"/>
    <!-- Збільшено y з 0.228 до 0.280 для виносу за межі циліндра -->
    <origin xyz="0.180 0.280 0.048" rpy="0 0 1.3265"/>
  </joint>

  <!-- 7. Right Sensor (-76°) -->
  <!-- Винесений за межі корпусу для уникнення блокування променів -->
  <link name="sensor_right">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.02 0.02"/>
      </geometry>
      <material name="red"/>
    </visual>
  </link>

  <joint name="sensor_right_joint" type="fixed">
    <parent link="base_link"/>
    <child link="sensor_right"/>
    <!-- Збільшено y з -0.228 до -0.280 для виносу за межі циліндра -->
    <origin xyz="0.180 -0.280 0.048" rpy="0 0 -1.3265"/>
  </joint>

  <!-- RPLiDAR A1M8 -->
  <!-- 2D Lidar on front of robot at 80cm height -->
  <!-- Specs: 360° capable, using 180° FOV (front hemisphere) -->
  <!-- Range: 0.15m - 12m, Frequency: 5.5Hz -->
  <link name="lidar_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <!-- RPLiDAR A1M8: diameter 76mm, height 40mm -->
        <cylinder radius="0.038" length="0.04"/>
      </geometry>
      <material name="black"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.038" length="0.04"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.190"/>  <!-- 190g -->
      <inertia
        ixx="0.00001" ixy="0.0" ixz="0.0"
        iyy="0.00001" iyz="0.0"
        izz="0.00001"/>
    </inertial>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <!-- Lidar mounted on front of robot
         X: 0.28m forward (front edge)
         Y: 0.0m (center)
         Z: 0.70m above base_link = 0.80m above ground (base_footprint)
         Note: base_link is 0.1m above ground -->
    <origin xyz="0.28 0 0.70" rpy="0 0 0"/>
  </joint>

  <!-- IMU (MPU-6050 simulation) -->
  <!-- Simulates the real MPU-6050 accelerometer + gyroscope + magnetometer -->
  <link name="imu_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.02 0.01"/>
      </geometry>
      <material name="gray"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.02 0.01"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.001"/>
      <inertia
        ixx="0.000001" ixy="0.0" ixz="0.0"
        iyy="0.000001" iyz="0.0"
        izz="0.000001"/>
    </inertial>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <!-- IMU positioned at center of robot, slightly above base_link -->
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
  </joint>

  <!-- Base Footprint -->
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
  </joint>

  <!-- ========== GAZEBO PLUGINS ========== -->

  <!-- Differential Drive Plugin -->
  <gazebo>
    <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
      <!-- Update rate in Hz -->
      <update_rate>50</update_rate>

      <!-- Wheels -->
      <left_joint>wheel_left_joint</left_joint>
      <right_joint>wheel_right_joint</right_joint>

      <!-- Kinematics -->
      <wheel_separation>0.356</wheel_separation>
      <wheel_diameter>0.2</wheel_diameter>

      <!-- Limits -->
      <max_wheel_torque>50</max_wheel_torque>
      <max_wheel_acceleration>2.0</max_wheel_acceleration>

      <!-- Input -->
      <command_topic>cmd_vel</command_topic>

      <!-- Output -->
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>true</publish_wheel_tf>

      <odometry_topic>odom</odometry_topic>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
    </plugin>
  </gazebo>

  <!-- Gazebo material properties for links -->
  <gazebo reference="base_link">
    <material>Gazebo/Blue</material>
  </gazebo>

  <gazebo reference="wheel_left">
    <material>Gazebo/Black</material>
    <mu1>2.5</mu1>
    <mu2>2.5</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>1.0</maxVel>
  </gazebo>

  <gazebo reference="wheel_right">
    <material>Gazebo/Black</material>
    <mu1>2.5</mu1>
    <mu2>2.5</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>1.0</maxVel>
  </gazebo>

  <gazebo reference="caster_back">
    <material>Gazebo/Grey</material>
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.001</minDepth>
  </gazebo>

  <gazebo reference="camera_tof">
    <material>Gazebo/Red</material>
  </gazebo>

  <!-- Ray sensors for distance sensors (7 sensors) -->
  <gazebo reference="sensor_front_center">
    <sensor type="ray" name="sensor_front_center">
      <pose>0 0 0 0 0 0</pose>
      <visualize>true</visualize>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>5</samples>
            <resolution>1</resolution>
            <min_angle>-0.01</min_angle>
            <max_angle>0.01</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.02</min>
          <max>4.0</max>
          <resolution>0.01</resolution>
        </range>
      </ray>
      <plugin name="gazebo_ros_sensor_front_center" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <namespace>/verter</namespace>
          <remapping>~/out:=distance_sensors/front_center</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>sensor_front_center</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <gazebo reference="sensor_front_left_inner">
    <sensor type="ray" name="sensor_front_left_inner">
      <pose>0 0 0 0 0 0</pose>
      <visualize>true</visualize>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>5</samples>
            <resolution>1</resolution>
            <min_angle>-0.01</min_angle>
            <max_angle>0.01</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.02</min>
          <max>4.0</max>
          <resolution>0.01</resolution>
        </range>
      </ray>
      <plugin name="gazebo_ros_sensor_front_left_inner" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <namespace>/verter</namespace>
          <remapping>~/out:=distance_sensors/front_left_inner</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>sensor_front_left_inner</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <gazebo reference="sensor_front_left_outer">
    <sensor type="ray" name="sensor_front_left_outer">
      <pose>0 0 0 0 0 0</pose>
      <visualize>true</visualize>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>5</samples>
            <resolution>1</resolution>
            <min_angle>-0.01</min_angle>
            <max_angle>0.01</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.02</min>
          <max>4.0</max>
          <resolution>0.01</resolution>
        </range>
      </ray>
      <plugin name="gazebo_ros_sensor_front_left_outer" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <namespace>/verter</namespace>
          <remapping>~/out:=distance_sensors/front_left_outer</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>sensor_front_left_outer</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <gazebo reference="sensor_front_right_inner">
    <sensor type="ray" name="sensor_front_right_inner">
      <pose>0 0 0 0 0 0</pose>
      <visualize>true</visualize>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>5</samples>
            <resolution>1</resolution>
            <min_angle>-0.01</min_angle>
            <max_angle>0.01</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.02</min>
          <max>4.0</max>
          <resolution>0.01</resolution>
        </range>
      </ray>
      <plugin name="gazebo_ros_sensor_front_right_inner" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <namespace>/verter</namespace>
          <remapping>~/out:=distance_sensors/front_right_inner</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>sensor_front_right_inner</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <gazebo reference="sensor_front_right_outer">
    <sensor type="ray" name="sensor_front_right_outer">
      <pose>0 0 0 0 0 0</pose>
      <visualize>true</visualize>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>5</samples>
            <resolution>1</resolution>
            <min_angle>-0.01</min_angle>
            <max_angle>0.01</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.02</min>
          <max>4.0</max>
          <resolution>0.01</resolution>
        </range>
      </ray>
      <plugin name="gazebo_ros_sensor_front_right_outer" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <namespace>/verter</namespace>
          <remapping>~/out:=distance_sensors/front_right_outer</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>sensor_front_right_outer</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <gazebo reference="sensor_left">
    <sensor type="ray" name="sensor_left">
      <pose>0 0 0 0 0 0</pose>
      <visualize>true</visualize>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>5</samples>
            <resolution>1</resolution>
            <min_angle>-0.01</min_angle>
            <max_angle>0.01</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.02</min>
          <max>4.0</max>
          <resolution>0.01</resolution>
        </range>
      </ray>
      <plugin name="gazebo_ros_sensor_left" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <namespace>/verter</namespace>
          <remapping>~/out:=distance_sensors/left</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>sensor_left</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <gazebo reference="sensor_right">
    <sensor type="ray" name="sensor_right">
      <pose>0 0 0 0 0 0</pose>
      <visualize>true</visualize>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>5</samples>
            <resolution>1</resolution>
            <min_angle>-0.01</min_angle>
            <max_angle>0.01</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.02</min>
          <max>4.0</max>
          <resolution>0.01</resolution>
        </range>
      </ray>
      <plugin name="gazebo_ros_sensor_right" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <namespace>/verter</namespace>
          <remapping>~/out:=distance_sensors/right</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>sensor_right</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- RPLiDAR A1M8 Plugin -->
  <!-- 2D Laser Scanner simulating RPLiDAR A1M8 with 120° FOV -->
  <gazebo reference="lidar_link">
    <sensor type="ray" name="rplidar_a1m8">
      <pose>0 0 0 0 0 0</pose>
      <visualize>true</visualize>
      <update_rate>5.5</update_rate>  <!-- RPLiDAR A1M8: 5.5 Hz typical -->
      <ray>
        <scan>
          <horizontal>
            <!-- 240 samples for smooth scan, using 120° FOV -->
            <samples>240</samples>
            <resolution>1</resolution>
            <!-- 120° FOV: from -60° to +60° (front sector) -->
            <min_angle>-1.0472</min_angle>  <!-- -π/3 = -60° -->
            <max_angle>1.0472</max_angle>   <!-- +π/3 = +60° -->
          </horizontal>
        </scan>
        <range>
          <!-- RPLiDAR A1M8 specifications -->
          <min>0.15</min>  <!-- 15cm minimum range -->
          <max>12.0</max>  <!-- 12m maximum range -->
          <resolution>0.01</resolution>  <!-- 1cm resolution -->
        </range>
        <noise>
          <!-- Add realistic noise for simulation -->
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>  <!-- 1cm standard deviation -->
        </noise>
      </ray>
      <plugin name="gazebo_ros_lidar" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <namespace>/verter</namespace>
          <remapping>~/out:=scan</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>lidar_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- IMU Sensor Plugin (MPU-6050 + Magnetometer simulation) -->
  <!-- Publishes /imu/data (orientation, angular velocity, linear acceleration) -->
  <gazebo reference="imu_link">
    <gravity>true</gravity>
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>100</update_rate>  <!-- 100 Hz - typical for MPU-6050 -->
      <visualize>true</visualize>

      <plugin filename="libgazebo_ros_imu_sensor.so" name="imu_plugin">
        <ros>
          <namespace>/verter</namespace>
          <remapping>~/out:=imu/data</remapping>
        </ros>

        <!-- Frame name for the IMU -->
        <initial_orientation_as_reference>false</initial_orientation_as_reference>
        <frame_name>imu_link</frame_name>

        <!-- Noise parameters (based on MPU-6050 datasheet) -->
        <!-- Angular velocity noise (gyroscope) -->
        <angular_velocity_stdev>0.0002</angular_velocity_stdev>

        <!-- Linear acceleration noise (accelerometer) -->
        <linear_acceleration_stdev>0.017</linear_acceleration_stdev>

        <!-- Orientation noise (magnetometer/compass) -->
        <orientation_stdev>0.01</orientation_stdev>
      </plugin>
    </sensor>
  </gazebo>

</robot>