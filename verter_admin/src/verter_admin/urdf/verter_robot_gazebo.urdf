<?xml version="1.0"?>
<!-- URDF Model for Verter Robot - Gazebo Simulation Version -->
<robot name="verter_robot">

  <!-- Materials -->
  <material name="blue">
    <color rgba="0.0 0.0 0.8 1.0"/>
  </material>

  <material name="black">
    <color rgba="0.0 0.0 0.0 1.0"/>
  </material>

  <material name="red">
    <color rgba="0.8 0.0 0.0 1.0"/>
  </material>

  <material name="gray">
    <color rgba="0.5 0.5 0.5 1.0"/>
  </material>

  <!-- Base Link (Main Body) -->
  <!-- Циліндрична форма для більш реалістичної моделі -->
  <!-- Радіус ~0.267м (половина ширини 534мм), висота 550мм -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.275" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.267" length="0.550"/>
      </geometry>
      <material name="blue"/>
    </visual>

    <collision>
      <origin xyz="0 0 0.275" rpy="0 0 0"/>
      <geometry>
        <!-- Collision трохи менший для кращої маневреності -->
        <cylinder radius="0.250" length="0.550"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0.150" rpy="0 0 0"/>
      <mass value="12.0"/>
      <inertia
        ixx="0.2" ixy="0.0" ixz="0.0"
        iyy="0.2" iyz="0.0"
        izz="0.3"/>
    </inertial>
  </link>

  <!-- Left Wheel -->
  <link name="wheel_left">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.1" length="0.05"/>
      </geometry>
      <material name="black"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.1" length="0.05"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="2.0"/>
      <inertia
        ixx="0.01" ixy="0.0" ixz="0.0"
        iyy="0.01" iyz="0.0"
        izz="0.01"/>
    </inertial>
  </link>

  <joint name="wheel_left_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_left"/>
    <origin xyz="0.120 0.178 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.2" friction="0.1"/>
  </joint>

  <!-- Right Wheel -->
  <link name="wheel_right">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.1" length="0.05"/>
      </geometry>
      <material name="black"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.1" length="0.05"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="2.0"/>
      <inertia
        ixx="0.01" ixy="0.0" ixz="0.0"
        iyy="0.01" iyz="0.0"
        izz="0.01"/>
    </inertial>
  </link>

  <joint name="wheel_right_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_right"/>
    <origin xyz="0.120 -0.178 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.2" friction="0.1"/>
  </joint>

  <!-- Caster Wheel (Back) -->
  <link name="caster_back">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.05"/>
      </geometry>
      <material name="gray"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.05"/>
      </geometry>
      <surface>
        <friction>
          <ode>
            <mu>0.01</mu>
            <mu2>0.01</mu2>
          </ode>
        </friction>
      </surface>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia
        ixx="0.001" ixy="0.0" ixz="0.0"
        iyy="0.001" iyz="0.0"
        izz="0.001"/>
    </inertial>
  </link>

  <joint name="caster_back_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_back"/>
    <origin xyz="-0.22 0 -0.05" rpy="0 0 0"/>
  </joint>

  <!-- Distance Sensors (7 sensors) -->

  <!-- 1. Front Center (0°) -->
  <link name="sensor_front_center">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.02 0.02"/>
      </geometry>
      <material name="red"/>
    </visual>
  </link>

  <joint name="sensor_front_center_joint" type="fixed">
    <parent link="base_link"/>
    <child link="sensor_front_center"/>
    <origin xyz="0.280 0 0.048" rpy="0 0 0"/>
  </joint>

  <!-- 2. Front Left Inner (5,7°) -->
  <link name="sensor_front_left_inner">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.02 0.02"/>
      </geometry>
      <material name="red"/>
    </visual>
  </link>

  <joint name="sensor_front_left_inner_joint" type="fixed">
    <parent link="base_link"/>
    <child link="sensor_front_left_inner"/>
    <origin xyz="0.277 0.074 0.048" rpy="0 0 0.0995"/>
  </joint>

  <!-- 3. Front Left Outer (13,2°) -->
  <link name="sensor_front_left_outer">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.02 0.02"/>
      </geometry>
      <material name="red"/>
    </visual>
  </link>

  <joint name="sensor_front_left_outer_joint" type="fixed">
    <parent link="base_link"/>
    <child link="sensor_front_left_outer"/>
    <origin xyz="0.262 0.152 0.048" rpy="0 0 0.2304"/>
  </joint>

  <!-- 4. Front Right Inner (-5,7°) -->
  <link name="sensor_front_right_inner">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.02 0.02"/>
      </geometry>
      <material name="red"/>
    </visual>
  </link>

  <joint name="sensor_front_right_inner_joint" type="fixed">
    <parent link="base_link"/>
    <child link="sensor_front_right_inner"/>
    <origin xyz="0.277 -0.074 0.048" rpy="0 0 -0.0995"/>
  </joint>

  <!-- 5. Front Right Outer (-13,2°) -->
  <link name="sensor_front_right_outer">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.02 0.02"/>
      </geometry>
      <material name="red"/>
    </visual>
  </link>

  <joint name="sensor_front_right_outer_joint" type="fixed">
    <parent link="base_link"/>
    <child link="sensor_front_right_outer"/>
    <origin xyz="0.262 -0.152 0.048" rpy="0 0 -0.2304"/>
  </joint>

  <!-- 6. Left Sensor (76°) -->
  <!-- Винесений за межі корпусу для уникнення блокування променів -->
  <link name="sensor_left">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.02 0.02"/>
      </geometry>
      <material name="red"/>
    </visual>
  </link>

  <joint name="sensor_left_joint" type="fixed">
    <parent link="base_link"/>
    <child link="sensor_left"/>
    <!-- Збільшено y з 0.228 до 0.280 для виносу за межі циліндра -->
    <origin xyz="0.180 0.280 0.048" rpy="0 0 1.3265"/>
  </joint>

  <!-- 7. Right Sensor (-76°) -->
  <!-- Винесений за межі корпусу для уникнення блокування променів -->
  <link name="sensor_right">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.02 0.02"/>
      </geometry>
      <material name="red"/>
    </visual>
  </link>

  <joint name="sensor_right_joint" type="fixed">
    <parent link="base_link"/>
    <child link="sensor_right"/>
    <!-- Збільшено y з -0.228 до -0.280 для виносу за межі циліндра -->
    <origin xyz="0.180 -0.280 0.048" rpy="0 0 -1.3265"/>
  </joint>

  <!-- ToF Camera (Arducam US981) -->
  <!-- Розміщена над корпусом для кращого огляду -->
  <link name="camera_tof">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.03 0.06 0.02"/>
      </geometry>
      <material name="gray"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.03 0.06 0.02"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.02"/>
      <inertia
        ixx="0.00001" ixy="0.0" ixz="0.0"
        iyy="0.00001" iyz="0.0"
        izz="0.00001"/>
    </inertial>
  </link>

  <joint name="camera_tof_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_tof"/>
    <!-- Камера впереди робота на уровне корпуса для лучшего обзора -->
    <origin xyz="0.400 0 0.300" rpy="0 0 0"/>
  </joint>

  <!-- ToF Camera Optical Frame -->
  <link name="camera_tof_optical"/>

  <joint name="camera_tof_optical_joint" type="fixed">
    <parent link="camera_tof"/>
    <child link="camera_tof_optical"/>
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
  </joint>

  <!-- Base Footprint -->
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
  </joint>

  <!-- ========== GAZEBO PLUGINS ========== -->

  <!-- Differential Drive Plugin -->
  <gazebo>
    <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
      <!-- Update rate in Hz -->
      <update_rate>50</update_rate>

      <!-- Wheels -->
      <left_joint>wheel_left_joint</left_joint>
      <right_joint>wheel_right_joint</right_joint>

      <!-- Kinematics -->
      <wheel_separation>0.356</wheel_separation>
      <wheel_diameter>0.2</wheel_diameter>

      <!-- Limits -->
      <max_wheel_torque>20</max_wheel_torque>
      <max_wheel_acceleration>1.0</max_wheel_acceleration>

      <!-- Input -->
      <command_topic>cmd_vel</command_topic>

      <!-- Output -->
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>false</publish_wheel_tf>

      <odometry_topic>odom</odometry_topic>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
    </plugin>
  </gazebo>

  <!-- Gazebo material properties for links -->
  <gazebo reference="base_link">
    <material>Gazebo/Blue</material>
  </gazebo>

  <gazebo reference="wheel_left">
    <material>Gazebo/Black</material>
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>1.0</maxVel>
  </gazebo>

  <gazebo reference="wheel_right">
    <material>Gazebo/Black</material>
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>1.0</maxVel>
  </gazebo>

  <gazebo reference="caster_back">
    <material>Gazebo/Grey</material>
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.001</minDepth>
  </gazebo>

  <gazebo reference="camera_tof">
    <material>Gazebo/Red</material>
  </gazebo>

  <!-- Ray sensors for distance sensors (7 sensors) -->
  <gazebo reference="sensor_front_center">
    <sensor type="ray" name="sensor_front_center">
      <pose>0 0 0 0 0 0</pose>
      <visualize>true</visualize>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>5</samples>
            <resolution>1</resolution>
            <min_angle>-0.01</min_angle>
            <max_angle>0.01</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.02</min>
          <max>4.0</max>
          <resolution>0.01</resolution>
        </range>
      </ray>
      <plugin name="gazebo_ros_sensor_front_center" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <namespace>/verter</namespace>
          <remapping>~/out:=distance_sensors/front_center</remapping>
        </ros>
        <output_type>sensor_msgs/Range</output_type>
        <frame_name>sensor_front_center</frame_name>
        <radiation_type>infrared</radiation_type>
      </plugin>
    </sensor>
  </gazebo>

  <gazebo reference="sensor_front_left_inner">
    <sensor type="ray" name="sensor_front_left_inner">
      <pose>0 0 0 0 0 0</pose>
      <visualize>true</visualize>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>5</samples>
            <resolution>1</resolution>
            <min_angle>-0.01</min_angle>
            <max_angle>0.01</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.02</min>
          <max>4.0</max>
          <resolution>0.01</resolution>
        </range>
      </ray>
      <plugin name="gazebo_ros_sensor_front_left_inner" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <namespace>/verter</namespace>
          <remapping>~/out:=distance_sensors/front_left_inner</remapping>
        </ros>
        <output_type>sensor_msgs/Range</output_type>
        <frame_name>sensor_front_left_inner</frame_name>
        <radiation_type>infrared</radiation_type>
      </plugin>
    </sensor>
  </gazebo>

  <gazebo reference="sensor_front_left_outer">
    <sensor type="ray" name="sensor_front_left_outer">
      <pose>0 0 0 0 0 0</pose>
      <visualize>true</visualize>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>5</samples>
            <resolution>1</resolution>
            <min_angle>-0.01</min_angle>
            <max_angle>0.01</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.02</min>
          <max>4.0</max>
          <resolution>0.01</resolution>
        </range>
      </ray>
      <plugin name="gazebo_ros_sensor_front_left_outer" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <namespace>/verter</namespace>
          <remapping>~/out:=distance_sensors/front_left_outer</remapping>
        </ros>
        <output_type>sensor_msgs/Range</output_type>
        <frame_name>sensor_front_left_outer</frame_name>
        <radiation_type>infrared</radiation_type>
      </plugin>
    </sensor>
  </gazebo>

  <gazebo reference="sensor_front_right_inner">
    <sensor type="ray" name="sensor_front_right_inner">
      <pose>0 0 0 0 0 0</pose>
      <visualize>true</visualize>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>5</samples>
            <resolution>1</resolution>
            <min_angle>-0.01</min_angle>
            <max_angle>0.01</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.02</min>
          <max>4.0</max>
          <resolution>0.01</resolution>
        </range>
      </ray>
      <plugin name="gazebo_ros_sensor_front_right_inner" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <namespace>/verter</namespace>
          <remapping>~/out:=distance_sensors/front_right_inner</remapping>
        </ros>
        <output_type>sensor_msgs/Range</output_type>
        <frame_name>sensor_front_right_inner</frame_name>
        <radiation_type>infrared</radiation_type>
      </plugin>
    </sensor>
  </gazebo>

  <gazebo reference="sensor_front_right_outer">
    <sensor type="ray" name="sensor_front_right_outer">
      <pose>0 0 0 0 0 0</pose>
      <visualize>true</visualize>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>5</samples>
            <resolution>1</resolution>
            <min_angle>-0.01</min_angle>
            <max_angle>0.01</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.02</min>
          <max>4.0</max>
          <resolution>0.01</resolution>
        </range>
      </ray>
      <plugin name="gazebo_ros_sensor_front_right_outer" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <namespace>/verter</namespace>
          <remapping>~/out:=distance_sensors/front_right_outer</remapping>
        </ros>
        <output_type>sensor_msgs/Range</output_type>
        <frame_name>sensor_front_right_outer</frame_name>
        <radiation_type>infrared</radiation_type>
      </plugin>
    </sensor>
  </gazebo>

  <gazebo reference="sensor_left">
    <sensor type="ray" name="sensor_left">
      <pose>0 0 0 0 0 0</pose>
      <visualize>true</visualize>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>5</samples>
            <resolution>1</resolution>
            <min_angle>-0.01</min_angle>
            <max_angle>0.01</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.02</min>
          <max>4.0</max>
          <resolution>0.01</resolution>
        </range>
      </ray>
      <plugin name="gazebo_ros_sensor_left" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <namespace>/verter</namespace>
          <remapping>~/out:=distance_sensors/left</remapping>
        </ros>
        <output_type>sensor_msgs/Range</output_type>
        <frame_name>sensor_left</frame_name>
        <radiation_type>infrared</radiation_type>
      </plugin>
    </sensor>
  </gazebo>

  <gazebo reference="sensor_right">
    <sensor type="ray" name="sensor_right">
      <pose>0 0 0 0 0 0</pose>
      <visualize>true</visualize>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>5</samples>
            <resolution>1</resolution>
            <min_angle>-0.01</min_angle>
            <max_angle>0.01</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.02</min>
          <max>4.0</max>
          <resolution>0.01</resolution>
        </range>
      </ray>
      <plugin name="gazebo_ros_sensor_right" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <namespace>/verter</namespace>
          <remapping>~/out:=distance_sensors/right</remapping>
        </ros>
        <output_type>sensor_msgs/Range</output_type>
        <frame_name>sensor_right</frame_name>
        <radiation_type>infrared</radiation_type>
      </plugin>
    </sensor>
  </gazebo>

  <!-- Depth Camera Plugin (ToF Camera simulation) -->
  <!-- Simplified configuration to avoid macOS segfault -->
  <gazebo reference="camera_tof">
    <sensor type="depth" name="camera_tof">
      <always_on>true</always_on>
      <update_rate>5.0</update_rate>
      <camera>
        <horizontal_fov>2.0944</horizontal_fov>
        <image>
          <width>240</width>
          <height>180</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>4.0</far>
        </clip>
      </camera>
      <plugin name="camera_tof_controller" filename="libgazebo_ros_camera.so">
        <ros>
          <namespace>/verter</namespace>
          <remapping>camera_tof/image_raw:=camera_tof/image_raw</remapping>
          <remapping>camera_tof/camera_info:=camera_tof/camera_info</remapping>
          <remapping>camera_tof/depth/image_raw:=camera_tof/depth/image_raw</remapping>
          <remapping>camera_tof/depth/camera_info:=camera_tof/depth/camera_info</remapping>
          <remapping>camera_tof/points:=camera_tof/points</remapping>
        </ros>
        <camera_name>camera_tof</camera_name>
        <frame_name>camera_tof_optical</frame_name>
        <min_depth>0.05</min_depth>
        <max_depth>4.0</max_depth>
      </plugin>
    </sensor>
  </gazebo>

</robot>