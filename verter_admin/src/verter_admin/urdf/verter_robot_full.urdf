<?xml version="1.0"?>
<!--
===================================================================================
URDF МОДЕЛЬ РОБОТА VERTER
===================================================================================

ЧТО ТАКОЕ URDF?
----------------
URDF (Unified Robot Description Format) - это XML формат для описания:
- Физических размеров робота (длина, ширина, высота)
- Расположения колес, датчиков, камер
- TF трансформаций между частями робота
- Визуальной модели (для RViz)
- Collision модели (для Nav2 планирования пути)

ЗАЧЕМ ЭТО НУЖНО?
-----------------
1. Nav2 использует URDF для:
   - Понимания размеров робота (footprint)
   - Планирования пути с учетом габаритов
   - Collision detection при объезде препятствий

2. RViz использует URDF для:
   - Визуализации робота в 3D
   - Отображения TF дерева
   - Размещения сенсоров в правильных местах

3. TF2 использует URDF для:
   - Построения дерева координатных систем
   - Трансформаций между частями робота

ВАЖНО: ПАРАМЕТРЫ ДЛЯ НАСТРОЙКИ
-------------------------------
⚠️ Ниже используются ПРИМЕРНЫЕ размеры для типового мобильного робота.
⚠️ НЕОБХОДИМО ЗАМЕНИТЬ на реальные размеры вашего робота!

Места для изменения помечены комментариями:
  <!-- TODO: ИЗМЕРИТЬ И ЗАМЕНИТЬ НА РЕАЛЬНЫЕ ЗНАЧЕНИЯ -->

===================================================================================
-->

<robot name="verter_robot">

  <!--
  ===================================================================================
  МАТЕРИАЛЫ (для визуализации в RViz)
  ===================================================================================
  -->

  <!-- Материал для корпуса (синий) -->
  <material name="blue">
    <color rgba="0.0 0.0 0.8 1.0"/>
  </material>

  <!-- Материал для колес (черный) -->
  <material name="black">
    <color rgba="0.0 0.0 0.0 1.0"/>
  </material>

  <!-- Материал для датчиков (красный) -->
  <material name="red">
    <color rgba="0.8 0.0 0.0 1.0"/>
  </material>

  <!-- Материал для опорных колес (серый) -->
  <material name="gray">
    <color rgba="0.5 0.5 0.5 1.0"/>
  </material>


  <!--
  ===================================================================================
  BASE_LINK - ОСНОВНОЙ КОРПУС РОБОТА
  ===================================================================================

  Это центральная часть робота. Все остальные части (колеса, датчики)
  определяются относительно base_link.

  Система координат base_link:
    X - вперед (направление движения)
    Y - влево
    Z - вверх
  -->

  <link name="base_link">

    <!-- Визуальная модель (как выглядит в RViz) -->
    <visual>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry>
        <!-- TODO: ИЗМЕРИТЬ И ЗАМЕНИТЬ НА РЕАЛЬНЫЕ ЗНАЧЕНИЯ
             Текущие размеры (в метрах):
             - Длина (X): 0.40 м (40 см)
             - Ширина (Y): 0.50 м (50 см)
             - Высота (Z): 1.50 м (150 см)
        -->
        <box size="0.40 0.50 1.50"/>
      </geometry>
      <material name="blue"/>
    </visual>

    <!-- Collision модель (для Nav2) -->
    <!-- Обычно делается чуть больше визуальной модели для безопасности -->
    <collision>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry>
        <!-- Добавляем 2 см запас со всех сторон -->
        <box size="0.42 0.52 1.50"/>
      </geometry>
    </collision>

    <!-- Инерциальные свойства (для симуляции в Gazebo, опционально) -->
    <inertial>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <!-- TODO: ИЗМЕРИТЬ реальную массу робота (в кг) -->
      <mass value="2.0"/>
      <!-- Упрощенная матрица инерции для коробки -->
      <inertia
        ixx="0.01" ixy="0.0" ixz="0.0"
        iyy="0.01" iyz="0.0"
        izz="0.01"/>
    </inertial>
  </link>


  <!--
  ===================================================================================
  КОЛЕСА (Differential Drive - Дифференциальный привод)
  ===================================================================================

  Конфигурация робота Verter:
  - 2 ведущих колеса СПЕРЕДИ (слева и справа)
  - 1 опорное колесо СЗАДИ (caster wheel, крутящееся)
  - Коллекторные моторы с редуктором 12В

  Размеры колес:
  - Диаметр: 200 мм (радиус 100 мм = 0.1 м)
  - Ширина: 50 мм (0.05 м)
  -->

  <!-- ============ ЛЕВОЕ ВЕДУЩЕЕ КОЛЕСО ============ -->

  <link name="wheel_left">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <!-- ✅ РЕАЛЬНЫЕ РАЗМЕРЫ:
             - Диаметр: 200 мм → Радиус: 0.1 м (100 мм)
             - Ширина: 50 мм → 0.05 м
        -->
        <cylinder radius="0.1" length="0.05"/>
      </geometry>
      <material name="black"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.1" length="0.05"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia
        ixx="0.001" ixy="0.0" ixz="0.0"
        iyy="0.001" iyz="0.0"
        izz="0.001"/>
    </inertial>
  </link>

  <!-- Соединение (joint) между base_link и левым колесом -->
  <joint name="wheel_left_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_left"/>

    <!-- ✅ КОЛЕСА СПЕРЕДИ, не сзади!
         TODO: УТОЧНИТЬ точные позиции после измерений
         - X: 0.10 (колесо СПЕРЕДИ, 10 см от центра)
         - Y: 0.11 (колесо слева, 11 см от центра)
         - Z: 0 (на уровне земли)
    -->
    <origin xyz="0.10 0.11 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>


  <!-- ============ ПРАВОЕ ВЕДУЩЕЕ КОЛЕСО ============ -->

  <link name="wheel_right">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.1" length="0.05"/>
      </geometry>
      <material name="black"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.1" length="0.05"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia
        ixx="0.001" ixy="0.0" ixz="0.0"
        iyy="0.001" iyz="0.0"
        izz="0.001"/>
    </inertial>
  </link>

  <joint name="wheel_right_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_right"/>

    <!-- Правое колесо - зеркально левому, СПЕРЕДИ -->
    <origin xyz="0.10 -0.11 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>


  <!-- ============ ЗАДНЕЕ ОПОРНОЕ КОЛЕСО (CASTER) ============ -->

  <link name="caster_back">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <!-- TODO: ИЗМЕРИТЬ размер опорного колеса
             Обычно меньше основных колес
        -->
        <sphere radius="0.03"/>
      </geometry>
      <material name="gray"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.03"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.1"/>
      <inertia
        ixx="0.0001" ixy="0.0" ixz="0.0"
        iyy="0.0001" iyz="0.0"
        izz="0.0001"/>
    </inertial>
  </link>

  <joint name="caster_back_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_back"/>

    <!-- ✅ ОПОРНОЕ КОЛЕСО СЗАДИ, крутящееся
         TODO: ИЗМЕРИТЬ точную позицию
         - X: -0.12 (СЗАДИ, 12 см от центра)
         - Y: 0 (по центру)
         - Z: -0.07 (ниже base_link, учитывая высоту колеса)
    -->
    <origin xyz="-0.12 0 -0.07" rpy="0 0 0"/>
  </joint>


  <!--
  ===================================================================================
  ДАТЧИКИ РАССТОЯНИЯ (7 ультразвуковых датчиков)
  ===================================================================================

  Конфигурация датчиков Verter Robot:
  - 5 датчиков СПЕРЕДИ (направлены с разными углами для широкого обзора)
  - 2 датчика ПО БОКАМ (слева и справа)
  - Задних датчиков НЕТ

  Расположение (нумерация по коду distance_sensors_node.py):
  1. sensor_front_center       - передний центральный (0°, прямо)
  2. sensor_front_left_inner   - передний лево-внутренний (~20-30°)
  3. sensor_front_left_outer   - передний лево-внешний (~40-50°)
  4. sensor_front_right_inner  - передний право-внутренний (~-20-30°)
  5. sensor_front_right_outer  - передний право-внешний (~-40-50°)
  6. sensor_left               - левый боковой (90°)
  7. sensor_right              - правый боковой (-90°)
  -->

  <!-- ============ 1. ПЕРЕДНИЙ ЦЕНТРАЛЬНЫЙ ДАТЧИК ============ -->

  <link name="sensor_front_center">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.02 0.02"/>
      </geometry>
      <material name="red"/>
    </visual>
  </link>

  <joint name="sensor_front_center_joint" type="fixed">
    <parent link="base_link"/>
    <child link="sensor_front_center"/>

    <!-- TODO: ИЗМЕРИТЬ позицию датчика
         - X: спереди корпуса
         - Y: 0 (по центру)
         - Z: высота установки
         - Yaw: 0.0 (смотрит прямо вперед)
    -->
    <origin xyz="0.16 0 0.08" rpy="0 0 0"/>
  </joint>


  <!-- ============ 2. ПЕРЕДНИЙ ЛЕВО-ВНУТРЕННИЙ ДАТЧИК ============ -->

  <link name="sensor_front_left_inner">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.02 0.02"/>
      </geometry>
      <material name="red"/>
    </visual>
  </link>

  <joint name="sensor_front_left_inner_joint" type="fixed">
    <parent link="base_link"/>
    <child link="sensor_front_left_inner"/>

    <!-- TODO: ИЗМЕРИТЬ позицию
         Yaw: ~0.4363 рад = ~25° влево от центра
    -->
    <origin xyz="0.15 0.05 0.08" rpy="0 0 0.4363"/>
  </joint>


  <!-- ============ 3. ПЕРЕДНИЙ ЛЕВО-ВНЕШНИЙ ДАТЧИК ============ -->

  <link name="sensor_front_left_outer">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.02 0.02"/>
      </geometry>
      <material name="red"/>
    </visual>
  </link>

  <joint name="sensor_front_left_outer_joint" type="fixed">
    <parent link="base_link"/>
    <child link="sensor_front_left_outer"/>

    <!-- TODO: ИЗМЕРИТЬ позицию
         Yaw: ~0.7854 рад = ~45° влево от центра
    -->
    <origin xyz="0.14 0.10 0.08" rpy="0 0 0.7854"/>
  </joint>


  <!-- ============ 4. ПЕРЕДНИЙ ПРАВО-ВНУТРЕННИЙ ДАТЧИК ============ -->

  <link name="sensor_front_right_inner">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.02 0.02"/>
      </geometry>
      <material name="red"/>
    </visual>
  </link>

  <joint name="sensor_front_right_inner_joint" type="fixed">
    <parent link="base_link"/>
    <child link="sensor_front_right_inner"/>

    <!-- TODO: ИЗМЕРИТЬ позицию
         Yaw: ~-0.4363 рад = ~-25° вправо от центра
    -->
    <origin xyz="0.15 -0.05 0.08" rpy="0 0 -0.4363"/>
  </joint>


  <!-- ============ 5. ПЕРЕДНИЙ ПРАВО-ВНЕШНИЙ ДАТЧИК ============ -->

  <link name="sensor_front_right_outer">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.02 0.02"/>
      </geometry>
      <material name="red"/>
    </visual>
  </link>

  <joint name="sensor_front_right_outer_joint" type="fixed">
    <parent link="base_link"/>
    <child link="sensor_front_right_outer"/>

    <!-- TODO: ИЗМЕРИТЬ позицию
         Yaw: ~-0.7854 рад = ~-45° вправо от центра
    -->
    <origin xyz="0.14 -0.10 0.08" rpy="0 0 -0.7854"/>
  </joint>


  <!-- ============ 6. ЛЕВЫЙ БОКОВОЙ ДАТЧИК ============ -->

  <link name="sensor_left">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.02 0.02"/>
      </geometry>
      <material name="red"/>
    </visual>
  </link>

  <joint name="sensor_left_joint" type="fixed">
    <parent link="base_link"/>
    <child link="sensor_left"/>

    <!-- TODO: ИЗМЕРИТЬ позицию
         Yaw: 1.5708 рад = 90° (смотрит влево)
    -->
    <origin xyz="0 0.11 0.08" rpy="0 0 1.5708"/>
  </joint>


  <!-- ============ 7. ПРАВЫЙ БОКОВОЙ ДАТЧИК ============ -->

  <link name="sensor_right">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.02 0.02"/>
      </geometry>
      <material name="red"/>
    </visual>
  </link>

  <joint name="sensor_right_joint" type="fixed">
    <parent link="base_link"/>
    <child link="sensor_right"/>

    <!-- TODO: ИЗМЕРИТЬ позицию
         Yaw: -1.5708 рад = -90° (смотрит вправо)
    -->
    <origin xyz="0 -0.11 0.08" rpy="0 0 -1.5708"/>
  </joint>


  <!--
  ===================================================================================
  IMU (Инерциальный датчик) - PLACEHOLDER
  ===================================================================================

  IMU (Inertial Measurement Unit) включает:
  - Гироскоп (измеряет угловую скорость)
  - Акселерометр (измеряет ускорение)
  - Магнитометр (компас, измеряет магнитное поле Земли)

  Зачем нужен:
  - Улучшение одометрии (sensor fusion с колесной одометрией)
  - Определение ориентации робота
  - Коррекция дрейфа при поворотах
  - Для Nav2 и SLAM

  ⚠️ СТАТУС: НА ЭТАПЕ ПОДБОРА, НЕ УСТАНОВЛЕН
  Раскомментируйте секцию ниже когда IMU будет установлен
  -->

  <!--
  <link name="imu_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.03 0.03 0.01"/>
      </geometry>
      <material name="gray"/>
    </visual>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>

    <origin xyz="0 0 0.06" rpy="0 0 0"/>
  </joint>
  -->


  <!--
  ===================================================================================
  FOOTPRINT (след робота для Nav2)
  ===================================================================================

  Footprint - это проекция робота на плоскость земли. Nav2 использует это для:
  - Планирования пути
  - Проверки столкновений
  - Определения занимаемого пространства

  base_footprint располагается на уровне земли (z=0)
  -->

  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>

    <!-- base_link поднят над землей на высоту колеса -->
    <!-- ✅ РЕАЛЬНЫЙ радиус колеса: 0.1 м (100 мм) -->
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
  </joint>

</robot>
