#!/usr/bin/env bash
# verter — CLI утилита для робота Verter
#
# Установка (один раз, из каталога verter_admin):
#   chmod +x scripts/verter
#   sudo ln -sf "$(pwd)/scripts/verter" /usr/local/bin/verter
#
# Использование:
#   verter --save-map              # сохранить карту (спросит имя, Enter = timestamp)
#   verter --save-map my_map       # сохранить в ~/maps/my_map
#   verter --save-map ~/path/name  # сохранить по произвольному пути
#                                  # + сохранить док-позицию в <map>.dock.yaml
#   verter --nav map.yaml          # запустить навигацию по карте (без RViz)
#                                  # + автоприменить <map>.dock.yaml если он есть
#   verter --nav                   # автовыбор карты из ~/maps (если >1, покажет меню)
#   verter --nav --update          # git pull + colcon build, затем запуск nav
#   verter --nav ~/maps/map.yaml   # полный путь до карты

set -e

# ---------------------------------------------------------------------------
# Пути
# ---------------------------------------------------------------------------
_resolve_script_dir() {
    local src="${BASH_SOURCE[0]}"
    while [ -h "$src" ]; do
        local dir
        dir="$(cd -P "$(dirname "$src")" && pwd)"
        src="$(readlink "$src")"
        [[ "$src" != /* ]] && src="$dir/$src"
    done
    cd -P "$(dirname "$src")" && pwd
}

SCRIPT_DIR="$(_resolve_script_dir)"
VERTER_WS_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
VERTER_WS_SETUP="$VERTER_WS_DIR/install/setup.bash"

# ---------------------------------------------------------------------------
# ROS2 sourcing
# ---------------------------------------------------------------------------
_source_ros() {
    if ! command -v ros2 &>/dev/null; then
        source /opt/ros/humble/setup.bash 2>/dev/null || true
    fi
    if [ -f "$VERTER_WS_SETUP" ]; then
        source "$VERTER_WS_SETUP" 2>/dev/null || true
    fi
    if ! command -v ros2 &>/dev/null; then
        echo "Ошибка: ros2 не найден. Проверьте установку ROS2/окружение." >&2
        exit 127
    fi
}

_source_ros_base() {
    source /opt/ros/humble/setup.bash 2>/dev/null || true
}

# ---------------------------------------------------------------------------
# Dock pose helpers
# ---------------------------------------------------------------------------
_capture_dock_pose() {
    python3 - <<'PY'
import math
import sys
import time

try:
    import rclpy
    from rclpy.node import Node
    from rclpy.time import Time
    from tf2_ros import Buffer, TransformListener
except Exception:
    sys.exit(2)


def yaw_from_quaternion(q):
    siny_cosp = 2.0 * (q.w * q.z + q.x * q.y)
    cosy_cosp = 1.0 - 2.0 * (q.y * q.y + q.z * q.z)
    return math.atan2(siny_cosp, cosy_cosp)


rclpy.init(args=None)
node = Node('verter_dock_pose_capture')
tf_buffer = Buffer()
TransformListener(tf_buffer, node, spin_thread=False)

pose = None
robot_frame = None
deadline = time.time() + 5.0

while time.time() < deadline and rclpy.ok():
    rclpy.spin_once(node, timeout_sec=0.1)
    for candidate in ('base_footprint', 'base_link'):
        try:
            tf = tf_buffer.lookup_transform('map', candidate, Time())
        except Exception:
            continue
        q = tf.transform.rotation
        pose = (
            tf.transform.translation.x,
            tf.transform.translation.y,
            yaw_from_quaternion(q),
        )
        robot_frame = candidate
        break
    if pose is not None:
        break

node.destroy_node()
rclpy.shutdown()

if pose is None:
    sys.exit(1)

print(f"{pose[0]:.6f}|{pose[1]:.6f}|{pose[2]:.6f}|{robot_frame}|tf_map")
PY
}

_save_dock_pose_file() {
    local map_base="$1"
    local dock_file="${map_base}.dock.yaml"
    local pose_line
    pose_line="$(_capture_dock_pose 2>/dev/null || true)"

    if [ -z "$pose_line" ]; then
        echo "Предупреждение: не удалось получить док-позу из TF (map -> base_footprint/base_link)." >&2
        echo "Док-позиция не сохранена." >&2
        return 0
    fi

    local dock_x dock_y dock_yaw robot_frame source_name
    IFS='|' read -r dock_x dock_y dock_yaw robot_frame source_name <<<"$pose_line"

    if [ -z "$dock_x" ] || [ -z "$dock_y" ] || [ -z "$dock_yaw" ]; then
        echo "Предупреждение: получены некорректные данные док-позы, сохранение пропущено." >&2
        return 0
    fi

    {
        echo "frame_id: \"map\""
        echo "robot_frame: \"${robot_frame}\""
        echo "x: ${dock_x}"
        echo "y: ${dock_y}"
        echo "yaw: ${dock_yaw}"
        echo "saved_at: \"$(date -u +"%Y-%m-%dT%H:%M:%SZ")\""
        echo "map_yaml: \"${map_base}.yaml\""
        echo "source: \"${source_name}\""
    } >"$dock_file"

    echo "Док-позиция сохранена → $dock_file"
}

_update_workspace() {
    _source_ros_base

    if ! command -v git &>/dev/null; then
        echo "Ошибка: git не найден." >&2
        return 127
    fi
    if ! command -v colcon &>/dev/null; then
        echo "Ошибка: colcon не найден. Установите ROS2 build tools." >&2
        return 127
    fi

    echo "Обновление кода (git pull --ff-only) в $VERTER_WS_DIR"
    if ! (cd "$VERTER_WS_DIR" && git pull --ff-only); then
        echo "Ошибка: git pull завершился с ошибкой." >&2
        return 1
    fi

    echo "Сборка workspace (colcon build --symlink-install)"
    if ! (cd "$VERTER_WS_DIR" && colcon build --symlink-install); then
        echo "Ошибка: colcon build завершился с ошибкой." >&2
        return 1
    fi

    echo "Обновление и сборка завершены."
    return 0
}

_wait_for_node() {
    local node_name="$1"
    local timeout_sec="${2:-30}"
    local deadline=$((SECONDS + timeout_sec))

    while [ "$SECONDS" -lt "$deadline" ]; do
        if ros2 node list 2>/dev/null | grep -Fxq "$node_name"; then
            return 0
        fi
        sleep 1
    done
    return 1
}

_apply_dock_pose_file() {
    local dock_file="$1"
    if [ ! -f "$dock_file" ]; then
        return 1
    fi

    local dock_x dock_y dock_yaw
    dock_x="$(awk -F': ' '/^x:/{print $2; exit}' "$dock_file")"
    dock_y="$(awk -F': ' '/^y:/{print $2; exit}' "$dock_file")"
    dock_yaw="$(awk -F': ' '/^yaw:/{print $2; exit}' "$dock_file")"

    if [ -z "$dock_x" ] || [ -z "$dock_y" ] || [ -z "$dock_yaw" ]; then
        echo "Предупреждение: не удалось прочитать x/y/yaw из $dock_file" >&2
        return 1
    fi

    local quat qz qw
    if ! quat="$(python3 - "$dock_yaw" <<'PY'
import math
import sys

yaw = float(sys.argv[1])
print(f"{math.sin(yaw / 2.0):.9f} {math.cos(yaw / 2.0):.9f}")
PY
)"; then
        echo "Предупреждение: не удалось вычислить кватернион из yaw=$dock_yaw" >&2
        return 1
    fi
    read -r qz qw <<<"$quat"

    echo "Применяю док-позицию из $dock_file"
    echo "x=$dock_x, y=$dock_y, yaw=$dock_yaw"

    local msg
    msg="{header: {frame_id: map}, pose: {pose: {position: {x: $dock_x, y: $dock_y, z: 0.0}, orientation: {x: 0.0, y: 0.0, z: $qz, w: $qw}}}}"

    # Публикуем несколько раз для надежной доставки после старта AMCL.
    ros2 topic pub --once /initialpose geometry_msgs/msg/PoseWithCovarianceStamped "$msg" >/dev/null 2>&1 || true
    sleep 0.3
    ros2 topic pub --once /initialpose geometry_msgs/msg/PoseWithCovarianceStamped "$msg" >/dev/null 2>&1 || true
    sleep 0.3
    ros2 topic pub --once /initialpose geometry_msgs/msg/PoseWithCovarianceStamped "$msg" >/dev/null 2>&1 || true

    echo "Док-позиция отправлена в /initialpose"
    return 0
}

_resolve_nav_map_path() {
    local map_input="${1:-}"
    local map_path=""

    if [ -n "$map_input" ]; then
        if [[ "$map_input" == /* || "$map_input" == ~* ]]; then
            map_path="$map_input"
        else
            map_path=~/maps/"$map_input"
        fi

        map_path="${map_path/#\~/$HOME}"
        if [[ "$map_path" != *.yaml ]]; then
            map_path="${map_path}.yaml"
        fi

        if [ ! -f "$map_path" ]; then
            echo "Ошибка: файл карты не найден: $map_path" >&2
            return 2
        fi

        echo "$map_path"
        return 0
    fi

    local maps_dir="$HOME/maps"
    local -a maps=()
    if [ -d "$maps_dir" ]; then
        while IFS= read -r line; do
            maps+=("$line")
        done < <(find "$maps_dir" -maxdepth 1 -type f -name '*.yaml' ! -name '*.dock.yaml' | sort)
    fi

    local count="${#maps[@]}"
    if [ "$count" -eq 0 ]; then
        echo "Ошибка: в $maps_dir не найдено ни одной карты (*.yaml)." >&2
        return 2
    fi

    if [ "$count" -eq 1 ]; then
        echo "Автовыбор карты: ${maps[0]}" >&2
        echo "${maps[0]}"
        return 0
    fi

    if [ ! -t 0 ]; then
        echo "Ошибка: найдено несколько карт ($count), но нет интерактивного терминала для выбора." >&2
        echo "Укажите карту явно: verter --nav /home/jetson/maps/<name>.yaml" >&2
        return 2
    fi

    local selected=""
    if command -v whiptail &>/dev/null; then
        local -a menu=()
        local i=1
        local map
        for map in "${maps[@]}"; do
            menu+=("$i" "$(basename "$map")")
            i=$((i + 1))
        done

        local choice
        choice="$(whiptail --title "Verter nav" --menu "Выберите карту" 20 90 10 "${menu[@]}" 3>&1 1>&2 2>&3)" || return 130
        if ! [[ "$choice" =~ ^[0-9]+$ ]]; then
            echo "Ошибка: некорректный выбор карты." >&2
            return 2
        fi
        selected="${maps[$((choice - 1))]}"
    else
        echo "Найдено несколько карт. Выберите номер:"
        local i=1
        local map
        for map in "${maps[@]}"; do
            echo "  $i) $(basename "$map")"
            i=$((i + 1))
        done

        local choice=""
        while true; do
            read -r -p "Номер карты [1-$count]: " choice
            if [[ "$choice" =~ ^[0-9]+$ ]] && [ "$choice" -ge 1 ] && [ "$choice" -le "$count" ]; then
                selected="${maps[$((choice - 1))]}"
                break
            fi
            echo "Некорректный ввод, попробуйте еще раз."
        done
    fi

    echo "$selected"
    return 0
}

# ---------------------------------------------------------------------------
# Команды
# ---------------------------------------------------------------------------
cmd_save_map() {
    local name="${1:-}"
    local path

    if [ -z "$name" ] && [ -t 0 ]; then
        local default_name="map_$(date +%Y%m%d_%H%M%S)"
        read -r -p "Введите имя карты [${default_name}]: " name
        name="${name:-$default_name}"
    fi
    name="${name%.yaml}"
    name="${name%.pgm}"

    if [ -z "$name" ]; then
        path=~/maps/map_$(date +%Y%m%d_%H%M%S)
    elif [[ "$name" == /* || "$name" == ~* ]]; then
        path="$name"
    else
        path=~/maps/"$name"
    fi

    path="${path/#\~/$HOME}"   # раскрыть ~ если есть
    mkdir -p "$(dirname "$path")"

    echo "Сохранение карты → $path"
    echo "(нужен запущенный SLAM Toolbox или Nav2)"
    echo ""

    _source_ros
    set +e
    ros2 run nav2_map_server map_saver_cli -f "$path"
    local code=$?
    set -e

    if [ $code -eq 0 ]; then
        echo ""
        echo "Готово:"
        ls -lh "${path}.yaml" "${path}.pgm" 2>/dev/null || true
        _save_dock_pose_file "$path"
    else
        echo ""
        echo "Ошибка: не удалось сохранить карту (код $code)." >&2
    fi
    exit $code
}

cmd_nav() {
    local update_requested=0
    local map_input=""
    local -a launch_args=()
    local arg

    for arg in "$@"; do
        case "$arg" in
            --update)
                update_requested=1
                ;;
            map:=*)
                map_input="${arg#map:=}"
                ;;
            *)
                if [ -z "$map_input" ] && [[ "$arg" != -* ]] && [[ "$arg" != *:=* ]]; then
                    map_input="$arg"
                else
                    launch_args+=("$arg")
                fi
                ;;
        esac
    done

    if [ "$update_requested" -eq 1 ]; then
        _update_workspace || exit $?
    fi

    local map_path
    map_path="$(_resolve_nav_map_path "$map_input")" || exit $?

    local dock_path="${map_path%.yaml}.dock.yaml"

    _source_ros
    echo "Запуск навигации с картой: $map_path"

    if [ -f "$dock_path" ]; then
        echo "Найдена док-позиция: $dock_path"
        # Ждём AMCL и применяем dock-позу в фоне — не держим launch в background.
        # exec ros2 launch заменяет shell: Ctrl+C идёт напрямую в ros2 launch,
        # который корректно завершает все дочерние процессы (micro_ros_agent и др.)
        # через свой lifecycle — серийный порт освобождается правильно.
        (
            if _wait_for_node "/amcl" 35; then
                _apply_dock_pose_file "$dock_path" || true
            else
                echo "Предупреждение: /amcl не поднялся за 35с, dock-позиция не применена." >&2
            fi
        ) &
        exec ros2 launch verter_admin navigation.launch.py map:="$map_path" "${launch_args[@]}"
    fi

    echo "Док-позиция не найдена (${dock_path}) — запуск без автоприменения /initialpose."
    exec ros2 launch verter_admin navigation.launch.py map:="$map_path" "${launch_args[@]}"
}

cmd_help() {
    echo "Использование: verter <команда> [аргументы]"
    echo ""
    echo "Команды:"
    echo "  --save-map [name]   Сохранить текущую карту"
    echo "                        без аргумента спросит имя (Enter = map_YYYYMMDD_HHMMSS)"
    echo "                        verter --save-map my_map  → ~/maps/my_map"
    echo "                        verter --save-map ~/path/name"
    echo "                        также сохраняет док-позицию: <map>.dock.yaml"
    echo ""
    echo "  --nav [map.yaml]    Запустить navigation.launch.py (без RViz)"
    echo "                        verter --nav            → авто-выбор карты из ~/maps"
    echo "                        verter --nav map_20260227_142836"
    echo "                        verter --nav /home/jetson/maps/map_20260227_142836.yaml"
    echo "                        verter --nav --update   → git pull + colcon build + launch"
    echo "                        если рядом есть <map>.dock.yaml, поза применится автоматически"
    echo "                        доп. аргументы передаются в ros2 launch"
    echo ""
    echo "  --help              Показать эту справку"
}

# ---------------------------------------------------------------------------
# Точка входа
# ---------------------------------------------------------------------------
case "${1:-}" in
    --save-map)   cmd_save_map "${2:-}" ;;
    --nav)        cmd_nav "${2:-}" "${@:3}" ;;
    --help|-h|"") cmd_help ;;
    *)
        echo "Неизвестная команда: $1"
        echo ""
        cmd_help
        exit 1
        ;;
esac
